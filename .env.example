POSTGRES_DB=nutrition
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=local-development-only
APP_PORT=3000
DB_PORT=5433
COOKIE_SECURE=false
# Enable demo accounts only on a local demo installation.
DEMO_ENABLED=true
DEMO_USER_PASSWORD=DemoUser123!
DEMO_ADMIN_PASSWORD=DemoAdmin123!
# Phase 2: set a backend API key and a chat model that supports JSON Schema Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Phase 3: the vector schema expects 1536 dimensions.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_MINIMUM_SIMILARITY=0.30
